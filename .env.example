# PostgreSQL connection string used by the API and the blacklist importer.
# Matches the local docker-compose service (note the host port is 5433).
DATABASE_URL=postgresql://infosys:infosys@localhost:5433/infosys

# Connection pool bounds.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# Maximum number of companies accepted in a single blacklist check request.
BLACKLIST_MAX_COMPANIES_PER_REQUEST=500

# Minimum trigram similarity (0-1) for a fuzzy company-name match.
BLACKLIST_NAME_SIMILARITY_THRESHOLD=0.45

# How long a session cookie stays valid after sign-in.
AUTH_SESSION_TTL_DAYS=7
AUTH_SESSION_COOKIE_NAME=infosys_session
# Set true once the API is served over HTTPS.
AUTH_SESSION_COOKIE_SECURE=false

# Origins allowed to call the API with credentials (JSON array). The frontend's
# dev server runs on :3000.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
